# Copy to .env (gitignored, never commit it) and fill in real values.

# Compose reads COMPOSE_FILE from .env, restoring flag-free `docker compose up`
# for dev now that the overlay isn't named docker-compose.override.yml. Leave
# this out (or unset) on the VPS, where the prod file is applied explicitly:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

POSTGRES_DB=cornerstone
POSTGRES_USER=cornerstone
POSTGRES_PASSWORD=changeme

# Prod only — set on the VPS itself, or pass at deploy time.
# BACKEND_IMAGE=ghcr.io/<org>/cornerstone-backend:<tag>
